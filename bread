#!/data/data/com.termux/files/usr/bin/bash

set -e

# ============================================================
# bread
# ============================================================

DATA_DIR="${BREAD_DATA_DIR:-$PREFIX/share/bread}"

BREADS_JSON="$DATA_DIR/breads.json"

die() {
    echo "bread: $1" >&2
    exit 1
}

command -v python >/dev/null 2>&1 || die "Python is required"

[ -f "$BREADS_JSON" ] || die "breads.json not found: $BREADS_JSON"

SKIN="default"
COMMAND=""

while [ $# -gt 0 ]; do
    case "$1" in
        -l)
            [ -n "${2:-}" ] || die "missing skin name after -l"
            SKIN="$2"
            shift 2
            ;;
        rotate)
            COMMAND="rotate"
            shift
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

[ -n "$COMMAND" ] || die "usage: bread [-l skin] rotate"

SKIN_FILE="$(
    python - "$BREADS_JSON" "$SKIN" <<'PY'
import json
import sys

json_file = sys.argv[1]
skin = sys.argv[2]

with open(json_file, "r", encoding="utf-8") as f:
    data = json.load(f)

if skin not in data:
    print("", end="")
    sys.exit(1)

print(data[skin])
PY
)" || die "skin not found: $SKIN"

[ -n "$SKIN_FILE" ] || die "skin not found: $SKIN"

SKIN_PATH="$DATA_DIR/$SKIN_FILE"

[ -f "$SKIN_PATH" ] || die "skin file not found: $SKIN_PATH"

case "$COMMAND" in
    rotate)

        FRAMES="$(
            python - "$SKIN_PATH" <<'PY'
import re
import sys

file = sys.argv[1]

with open(file, "r", encoding="utf-8") as f:
    text = f.read()

parts = re.split(r'^---\s*$', text, flags=re.MULTILINE)

frames = []

for part in parts:
    match = re.search(r'^frame:\s*(\d+)\s*$', part, flags=re.MULTILINE)

    if not match:
        continue

    number = int(match.group(1))

    lines = part[match.end():].strip("\n")

    frames.append((number, lines))

frames.sort(key=lambda x: x[0])

for number, frame in frames:
    print(f"__FRAME__{number}")
    print(frame)
PY
        )"

        [ -n "$FRAMES" ] || die "no frames found in $SKIN_PATH"

        printf '\033[?25l'
        trap 'printf "\033[?25h"; exit' INT TERM EXIT

        while true; do
            while IFS= read -r line; do
                case "$line" in
                    __FRAME__*)
                        printf '\033[2J\033[H'
                        ;;
                    *)
                        printf '%s\n' "$line"
                        ;;
                esac
            done <<< "$FRAMES"
        done

        ;;
esac
